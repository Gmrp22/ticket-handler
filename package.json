{
  "name": "ticket-handler-backend",
  "version": "1.0.0",
  "description": "Backend to manage purchase tickets and the weekly payments to suppliers (Node.js, Express, PostgreSQL, Sequelize)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:api": "node tests/prepare-db.js && node --test --test-concurrency=1 --require ./tests/helpers/env.js \"tests/api/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "import": "node src/scripts/import-excel.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gmrp22/ticket-handler.git"
  },
  "keywords": [
    "tickets",
    "payments",
    "express",
    "sequelize",
    "postgresql"
  ],
  "author": "gmrp22",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Gmrp22/ticket-handler/issues"
  },
  "homepage": "https://github.com/Gmrp22/ticket-handler#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
